{
  "name": "@gracefullight/validate-branch",
  "version": "1.2.0",
  "description": "Git branch name validation tool with custom regexp support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "validate-branch": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "git",
    "branch",
    "validation",
    "cli",
    "git-hooks",
    "lint",
    "naming-convention",
    "workflow",
    "ci",
    "gitflow",
    "husky",
    "standard",
    "quality-control"
  ],
  "author": {
    "name": "Eunkwang Shin",
    "email": "gracefullight.dev@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gracefullight/pkgs.git",
    "directory": "packages/validate-branch"
  },
  "homepage": "https://github.com/gracefullight/pkgs/tree/main/packages/validate-branch#readme",
  "bugs": {
    "url": "https://github.com/gracefullight/pkgs/issues"
  },
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/gracefullight"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "isomorphic-git": "^1.42.6"
  }
}
