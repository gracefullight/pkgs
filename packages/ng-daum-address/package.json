{
  "name": "@gracefullight/ng-daum-address",
  "version": "1.1.0",
  "description": "Angular 21+ Daum Postcode address search component with signal-based API",
  "keywords": [
    "angular",
    "daum",
    "postcode",
    "address",
    "korean-address",
    "kakao",
    "component",
    "popup",
    "layer",
    "inline",
    "search",
    "zipcode",
    "postal-code",
    "korea"
  ],
  "license": "MIT",
  "author": {
    "name": "Eunkwang Shin",
    "email": "gracefullight.dev@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gracefullight/pkgs.git",
    "directory": "packages/ng-daum-address"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/gracefullight"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ng-daum-address.mjs"
    }
  },
  "main": "./dist/ng-daum-address.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "ngc && tsc-alias && vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json"
  },
  "peerDependencies": {
    "@angular/common": ">=21.0.0",
    "@angular/core": ">=21.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@analogjs/vitest-angular": "^2.8.0",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "tsc-alias": "^1.9.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zone.js": "^0.16.3"
  }
}
