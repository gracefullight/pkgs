{
  "name": "zotero-plugin-uts",
  "version": "0.1.4",
  "type": "module",
  "description": "Zotero plugin to copy bibliography in UTS APA 7th format",
  "author": {
    "name": "gracefullight",
    "email": "gracefullight.dev@gmail.com",
    "url": "https://github.com/gracefullight"
  },
  "license": "MIT",
  "homepage": "https://github.com/gracefullight/pkgs/tree/main/packages/zotero-plugin-uts",
  "repository": {
    "type": "git",
    "url": "https://github.com/gracefullight/pkgs.git",
    "directory": "packages/zotero-plugin-uts"
  },
  "bugs": {
    "url": "https://github.com/gracefullight/pkgs/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/gracefullight"
  },
  "keywords": [
    "zotero",
    "zotero-plugin",
    "citation",
    "bibliography",
    "uts",
    "apa7"
  ],
  "scripts": {
    "build": "tsup",
    "build:xpi": "bun run build && cd addon && zip -r ../zotero-plugin-uts@$(node -p \"require('../package.json').version\").xpi .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-csl": "^0.9.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "zotero-types": "^4.1.3"
  },
  "dependencies": {}
}
